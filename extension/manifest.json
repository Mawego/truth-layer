{
  "manifest_version": 3,
  "name": "Truth Layer",
  "version": "1.0",
  "description": "Real-time AI video detection using Llama Vision and SAM 3.1 via Baseten",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
